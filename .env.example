TEST_DOMAIN="https://webui.something.com/"

BUILDER_USERNAME="something@something.dk"
BUILDER_PASSWORD="Hunter2"

USER_USERNAME="something@something.dk"
USER_PASSWORD="Hunter2"

# Optional: tests/admin is skipped when unset.
ADMIN_USERNAME="something@something.dk"
ADMIN_PASSWORD="Hunter2"

# Group the builder shares test specialists with; the user account must be a member. Defaults to "Builder".
SHARE_GROUP="Builder"

# Base model of test specialists; the builder account must be able to use it. Defaults to "AarhusAI-default-v2".
BASE_MODEL="AarhusAI-default-v2"

# Per-test artifacts in screenshots/: PNG on by default, page HTML off.
SCREENSHOTS=1
HTML_DUMP=0
